{
  "name": "bitpane-ui",
  "version": "0.14.0",
  "description": "1-bit retro desktop UI: windows, icons, dialogs and bitmap fonts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./src/bitpane.css"
  },
  "files": [
    "dist",
    "src/bitpane.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "private": true,
  "license": "MIT",
  "author": "Christofer Roth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chroth/bitpane-ui.git"
  },
  "keywords": [
    "1-bit",
    "retro",
    "desktop",
    "ui",
    "windows",
    "pixel",
    "bitmap-font",
    "dither"
  ]
}
